{
  "name": "micro-tools",
  "title": "科研小盒",
  "description": "科研常用小工具集合：期刊·会议查询（JCR / CCF）、AI 投稿助手（摘要解读、期刊匹配与投稿准备）、文献图谱（BibTeX 本地分析与可视化）、数据库检索。支持 ZTools AI 或用户自己的 API，纯 Preload 模式，无构建步骤。",
  "version": "1.4.0",
  "author": "Asa12138",
  "email": "bfzede@gmail.com",
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload.js",
  "features": [
    {
      "code": "home",
      "explain": "打开科研小盒工具箱",
      "cmds": ["科研小盒", "kyxh", "科研工具"]
    },
    {
      "code": "journal",
      "explain": "查询期刊/会议的影响因子、分区与 CCF 等级，例如 期刊 Nature / 影响因子 JACS",
      "cmds": [
        "期刊",
        "影响因子",
        "journal",
        "if",
        "jcr",
        {
          "type": "over",
          "label": "查询期刊/会议",
          "minLength": 1
        }
      ]
    },
    {
      "code": "ccf",
      "explain": "查询 CCF 第七版推荐会议与期刊等级，例如 ccf CVPR / 会议 NeurIPS",
      "cmds": [
        "ccf",
        "会议",
        "会议等级",
        "conference"
      ]
    },
    {
      "code": "submission",
      "explain": "投稿助手：分析标题与摘要，比较期刊与投稿准备事项",
      "cmds": ["投稿助手", "投稿建议", "submission"]
    },
    {
      "code": "literature",
      "explain": "文献图谱：导入 BibTeX 分析年代、期刊、类型与主题共现",
      "cmds": ["文献图谱", "bib分析", "literature"]
    },
    {
      "code": "settings",
      "explain": "科研小盒模型与 API 设置",
      "cmds": ["科研小盒设置"]
    },
    {
      "code": "database",
      "explain": "常用科研数据库查询，例如 数据库 BRCA1 / ncbi genome",
      "cmds": ["数据库", "database", "ncbi", "pubmed", "genome"]
    }
  ]
}
